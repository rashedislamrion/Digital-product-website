APP_NAME="Digital Storefront"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database Configuration (MySQL 8.x / 9.x)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=digital_storefront
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# Mail Configuration (SMTP / Postmark / Mailgun / SES)
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="support@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Search Engine (Laravel Scout)
# -----------------------------------------------------------------------------
SCOUT_DRIVER=database
# MEILISEARCH_HOST=http://127.0.0.1:7700
# MEILISEARCH_KEY=

# -----------------------------------------------------------------------------
# Object Storage (Public marketing assets / screenshots)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Secure S3 Storage (Private licensed product binary packages / presigned URLs)
# Supports AWS S3, Cloudflare R2, and DigitalOcean Spaces
# -----------------------------------------------------------------------------
AWS_SECURE_ACCESS_KEY_ID=
AWS_SECURE_SECRET_ACCESS_KEY=
AWS_SECURE_DEFAULT_REGION=us-east-1
AWS_SECURE_BUCKET=
AWS_SECURE_ENDPOINT=
AWS_SECURE_USE_PATH_STYLE_ENDPOINT=false

# -----------------------------------------------------------------------------
# Local Bangladesh Payment Gateways
# -----------------------------------------------------------------------------
# SSLCOMMERZ Hosted Checkout & Order Validation API
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_SANDBOX=true

# bKash Direct URL Checkout
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_IS_SANDBOX=true

# -----------------------------------------------------------------------------
# International Payment Gateways & Merchant of Record (MoR)
# -----------------------------------------------------------------------------
# Paddle Billing
PADDLE_VENDOR_ID=your_paddle_vendor_id
PADDLE_API_KEY=your_paddle_api_key
PADDLE_CLIENT_TOKEN=your_paddle_client_token
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret
PADDLE_SANDBOX=true

# Lemon Squeezy (MoR with Built-in Licensing)
LEMON_SQUEEZY_API_KEY=your_lemon_squeezy_api_key
LEMON_SQUEEZY_STORE_ID=your_lemon_squeezy_store_id
LEMON_SQUEEZY_SIGNING_SECRET=your_lemon_squeezy_webhook_secret

VITE_APP_NAME="${APP_NAME}"
